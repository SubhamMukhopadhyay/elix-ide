{
  "name": "elix-ide",
  "version": "1.0.0",
  "description": "Elix IDE — Universal Development Environment, AI Agent & Career Practice Platform",
  "homepage": "https://github.com/elix-ide/elix-ide",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.elix.ide",
    "productName": "Elix IDE",
    "directories": {
      "output": "release"
    },
    "icon": "public/app-icon.ico",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "public/app-icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Elix IDE",
      "uninstallDisplayName": "Elix IDE",
      "artifactName": "Elix-IDE-Setup.${ext}"
    },
    "mac": {
      "icon": "public/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Elix-IDE-Setup.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "public/icon.png",
      "category": "Development",
      "maintainer": "Elix Team <support@elixide.com>",
      "synopsis": "Elix IDE — Universal Development Environment & AI Agent",
      "description": "Universal Development Environment, AI Agent & Career Practice Platform",
      "artifactName": "Elix-IDE-Setup.${ext}",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ]
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "devel",
      "artifactName": "Elix-IDE-Setup.${ext}"
    },
    "rpm": {
      "category": "Development/Tools",
      "artifactName": "Elix-IDE-Setup.${ext}"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --dir",
    "build:installer": "tsc && vite build && electron-builder --win",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "build:deb": "node scripts/pack-deb.js",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "preview": "vite preview"
  },
  "keywords": [
    "ide",
    "ai",
    "dsa",
    "development-environment",
    "electron",
    "universal-ide"
  ],
  "author": {
    "name": "Elix Team",
    "email": "support@elixide.com"
  },
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "diff": "^5.2.0",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.52.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/diff": "^5.0.9",
    "@types/node": "^20.17.19",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
